#!/usr/bin/python3
"""Small offline GUI for local Windows SAM accounts."""

import json
import logging
import os
import platform
import re
import shutil
import subprocess
import tempfile
import threading
import tkinter as tk
from datetime import datetime, timezone
from pathlib import Path
from tkinter import filedialog, messagebox, ttk


LOG_DIR = Path('/run/rescue-gui')
LOG_DIR.mkdir(mode=0o700, exist_ok=True)
LOG_FILE = LOG_DIR / 'session.log'
logging.basicConfig(filename=LOG_FILE, level=logging.INFO,
                    format='%(asctime)s %(levelname)s %(message)s')
logging.info('rescue-gui started; kernel=%s; uid=%s', platform.release(), os.getuid())


def run(args, timeout=45):
    logging.info('exec: %s', ' '.join(map(str, args)))
    try:
        result = subprocess.run(args, text=True, capture_output=True,
                                errors='replace', timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        logging.exception('command failed: %s', exc)
        raise RuntimeError(str(exc)) from exc
    logging.info('exit=%s stdout=%r stderr=%r', result.returncode,
                 result.stdout[-10000:], result.stderr[-10000:])
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip()
                           or f'Command exited with {result.returncode}')
    return result.stdout


def user_names_from_hive(sam):
    """Read Unicode registry key names; fall back to sampasswd names."""
    try:
        import hivex
        hive = hivex.Hivex(str(sam), write=0)
        root = hive.root()
        for path in [('SAM', 'Domains', 'Account', 'Users', 'Names'),
                     ('Domains', 'Account', 'Users', 'Names')]:
            node = root
            for part in path:
                node = hive.node_get_child(node, part)
                if not node:
                    break
            if not node:
                continue
            names = {}
            for child in hive.node_children(node):
                values = hive.node_values(child)
                if values:
                    rid = hive.value_value(values[0])[0]
                    name = hive.node_name(child)
                    if isinstance(name, bytes):
                        name = name.decode('utf-8', 'replace')
                    names[rid] = name
            logging.info('hivex decoded %d Unicode user names', len(names))
            return names
    except Exception as exc:
        logging.warning('Unicode name decoding unavailable: %s', exc)
    return {}


def accounts_from_sam(sam):
    output = run(['/usr/sbin/sampasswd', '-l', str(sam)])
    names = user_names_from_hive(sam)
    accounts = []
    for line in output.splitlines():
        fields = line.split(':')
        if len(fields) < 5 or not re.fullmatch(r'[0-9a-fA-F]{1,8}', fields[0]):
            continue
        rid = int(fields[0], 16)
        accounts.append({'rid': f'{rid:04x}',
                         'name': names.get(rid) or fields[1] or '(имя недоступно)',
                         'admin': fields[2] == '1',
                         'flags': fields[3]})
    listed = {int(a['rid'], 16) for a in accounts}
    for rid, name in names.items():
        if rid not in listed:
            accounts.append({'rid': f'{rid:04x}', 'name': name,
                             'admin': None, 'flags': ''})
            logging.warning('account RID %04x found by hivex but omitted by sampasswd', rid)
    accounts.sort(key=lambda account: int(account['rid'], 16))
    logging.info('parsed %d SAM accounts: %s', len(accounts),
                 [(a['rid'], a['name'], a['admin']) for a in accounts])
    return accounts


def partitions():
    data = json.loads(run(['/usr/bin/lsblk', '-J', '-p', '-o',
                           'NAME,SIZE,FSTYPE,LABEL,TYPE,MOUNTPOINTS']))
    found = []
    def walk(nodes):
        for node in nodes:
            if node.get('type') == 'part' and node.get('fstype') == 'ntfs':
                found.append(node)
            walk(node.get('children', []))
    walk(data.get('blockdevices', []))
    logging.info('NTFS partitions: %s', found)
    return found


class MountedWindows:
    def __init__(self, device, read_write=False):
        self.device = device
        self.read_write = read_write
        self.point = None

    def __enter__(self):
        current = {item['name']: item for item in partitions()}
        if self.device not in current:
            raise RuntimeError('Выбранный раздел больше не найден. Обновите список.')
        if any(current[self.device].get('mountpoints') or []):
            raise RuntimeError('Раздел уже подключён. Сначала отключите его.')
        self.point = Path(tempfile.mkdtemp(prefix='windows-', dir='/mnt'))
        try:
            run(['/usr/bin/ntfs-3g', '-o', 'rw' if self.read_write else 'ro',
                 self.device, str(self.point)])
        except Exception:
            self.point.rmdir()
            self.point = None
            raise
        config = self.point / 'Windows/System32/config'
        if not (config / 'SAM').is_file():
            self.__exit__(None, None, None)
            raise RuntimeError('На этом разделе не найден Windows/System32/config/SAM.')
        return config

    def __exit__(self, *_):
        if self.point:
            run(['/usr/bin/sync'])
            try:
                run(['/usr/bin/umount', str(self.point)])
            finally:
                try:
                    self.point.rmdir()
                except OSError:
                    logging.error('mountpoint still present: %s', self.point)
            self.point = None


def make_backup(config):
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backup = config / f'chntpw-backup-{stamp}'
    backup.mkdir(mode=0o700)
    for name in ('SAM', 'SYSTEM', 'SECURITY'):
        source = config / name
        if source.is_file():
            shutil.copy2(source, backup / name)
    run(['/usr/bin/sync'])
    logging.info('hive backup created: %s', backup)
    return backup


class RescueGUI:
    def __init__(self, root):
        self.root = root
        self.root.title('Windows Rescue — chntpw / NTFS')
        self.root.geometry('900x650')
        self.root.minsize(750, 560)
        self.device = None
        self.accounts = {}
        self.busy = False
        self.status = tk.StringVar(value='Выберите раздел Windows.')
        book = ttk.Notebook(root)
        book.pack(fill='both', expand=True, padx=12, pady=12)
        main = ttk.Frame(book, padding=12)
        debug = ttk.Frame(book, padding=12)
        book.add(main, text='Восстановление')
        book.add(debug, text='Дебаг')

        ttk.Label(main, text='1. Выберите раздел Windows',
                  font=('DejaVu Sans', 13, 'bold')).pack(anchor='w')
        self.disks = ttk.Treeview(main, columns=('size', 'label'), show='tree headings', height=3)
        self.disks.heading('#0', text='Раздел')
        self.disks.heading('size', text='Размер')
        self.disks.heading('label', text='Метка')
        self.disks.pack(fill='x', pady=8)
        self.disks.bind('<<TreeviewSelect>>', self.choose_device)
        row = ttk.Frame(main)
        row.pack(fill='x')
        ttk.Button(row, text='Обновить диски', command=self.refresh_disks).pack(side='left')
        ttk.Button(row, text='Найти пользователей', command=self.load_users).pack(side='left', padx=8)

        ttk.Label(main, text='2. Выберите локальную учётную запись',
                  font=('DejaVu Sans', 13, 'bold')).pack(anchor='w', pady=(18, 0))
        self.users = ttk.Treeview(main, columns=('name', 'admin'), show='tree headings', height=6)
        self.users.heading('#0', text='RID')
        self.users.heading('name', text='Имя в SAM')
        self.users.heading('admin', text='Администратор')
        self.users.column('#0', width=90, stretch=False)
        self.users.column('name', width=420)
        self.users.column('admin', width=150, stretch=False)
        self.users.pack(fill='both', expand=True, pady=8)
        ttk.Label(main, text='Кириллические имена читаются из реестра; RID позволяет точно выбрать запись.').pack(anchor='w')
        actions = ttk.Frame(main)
        actions.pack(fill='x', pady=12)
        ttk.Button(actions, text='Сделать администратором',
                   command=lambda: self.change('promote')).pack(side='left')
        ttk.Button(actions, text='Разблокировать',
                   command=lambda: self.change('unlock')).pack(side='left', padx=8)
        ttk.Button(actions, text='Очистить пароль',
                   command=lambda: self.change('clear')).pack(side='left')
        ttk.Button(actions, text='Снять права администратора',
                   command=lambda: self.change('demote')).pack(side='left', padx=8)
        windows_actions = ttk.Frame(main)
        windows_actions.pack(fill='x', pady=(0, 8))
        ttk.Button(windows_actions, text='Подготовить помощник Windows',
                   command=self.prepare_windows_helper).pack(side='left')
        ttk.Label(windows_actions, text='Пароль, новый пользователь и обои — после входа в Windows.').pack(side='left', padx=8)
        ttk.Label(main, text='Работает с локальными учётными записями. Раздел BitLocker необходимо разблокировать отдельно.').pack(anchor='w')
        ttk.Label(main, textvariable=self.status, wraplength=830).pack(anchor='w', pady=(12, 0))

        ttk.Label(debug, text='Диагностика текущего сеанса (хранится в памяти до выключения)',
                  font=('DejaVu Sans', 12, 'bold')).pack(anchor='w')
        ttk.Label(debug, text='Отчёт содержит названия дисков и учётных записей; перед отправкой проверьте его.').pack(anchor='w', pady=(5, 8))
        self.log_text = tk.Text(debug, wrap='none', state='disabled')
        self.log_text.pack(fill='both', expand=True)
        debug_buttons = ttk.Frame(debug)
        debug_buttons.pack(fill='x', pady=8)
        ttk.Button(debug_buttons, text='Обновить журнал', command=self.show_log).pack(side='left')
        ttk.Button(debug_buttons, text='Сохранить отчёт…', command=self.export_log).pack(side='left', padx=8)
        self.refresh_disks()

    def task(self, label, work, done=None):
        if self.busy:
            return
        self.busy = True
        self.status.set(label)
        def worker():
            try:
                value = work()
                self.root.after(0, lambda: self.finish(label, value, done, None))
            except Exception as exc:
                logging.exception('%s failed', label)
                self.root.after(0, lambda err=str(exc): self.finish(label, None, done, err))
        threading.Thread(target=worker, daemon=True).start()

    def finish(self, label, value, done, error):
        self.busy = False
        self.show_log()
        if error:
            self.status.set(f'Ошибка: {error}')
            messagebox.showerror('Не удалось выполнить действие', error)
        else:
            self.status.set(f'{label}: готово')
            if done:
                done(value)

    def refresh_disks(self):
        def done(items):
            self.disks.delete(*self.disks.get_children())
            self.users.delete(*self.users.get_children())
            self.accounts = {}
            self.device = None
            for item in items:
                self.disks.insert('', 'end', iid=item['name'], text=item['name'],
                                  values=(item.get('size', ''), item.get('label') or ''))
        self.task('Поиск NTFS-разделов', partitions, done)

    def choose_device(self, _event=None):
        selected = self.disks.selection()
        self.device = selected[0] if selected else None
        self.users.delete(*self.users.get_children())
        self.accounts = {}
        if self.device:
            self.status.set(f'Выбран раздел {self.device}. Нажмите «Найти пользователей».')

    def load_users(self):
        if not self.device:
            messagebox.showinfo('Сначала раздел', 'Выберите раздел NTFS в верхнем списке.')
            return
        device = self.device
        def work():
            with MountedWindows(device) as config:
                return accounts_from_sam(config / 'SAM')
        def done(items):
            self.users.delete(*self.users.get_children())
            self.accounts = {a['rid']: a for a in items}
            for account in items:
                self.users.insert('', 'end', iid=account['rid'], text=account['rid'],
                                  values=(account['name'], 'Неизвестно' if account['admin'] is None
                                          else 'Да' if account['admin'] else 'Нет'))
            if not items:
                messagebox.showwarning('Пустой список', 'SAM найден, но учётные записи не прочитаны. Сохраните отчёт во вкладке «Дебаг».')
        self.task('Чтение пользователей', work, done)

    def change(self, action):
        selection = self.users.selection()
        if not self.device or not selection:
            messagebox.showinfo('Сначала пользователь', 'Выберите раздел и учётную запись.')
            return
        account = self.accounts[selection[0]]
        titles = {'promote': 'дать права администратора',
                  'unlock': 'разблокировать', 'clear': 'очистить пароль',
                  'demote': 'снять права администратора'}
        if action == 'promote' and account['admin']:
            messagebox.showinfo('Уже администратор', 'Эта учётная запись уже входит в группу администраторов.')
            return
        if action == 'demote' and account['admin'] is False:
            messagebox.showinfo('Уже обычный пользователь', 'Эта учётная запись не входит в группу администраторов.')
            return
        if not messagebox.askyesno('Подтверждение',
                                   f"Раздел: {self.device}\nПользователь: {account['name']} (RID {account['rid']})\n\n"
                                   f"Вы хотите {titles[action]} для этой записи? Перед изменением будет сохранена копия SAM."):
            return
        device, rid = self.device, account['rid']
        def work():
            with MountedWindows(device, read_write=True) as config:
                sam = config / 'SAM'
                current = {a['rid']: a for a in accounts_from_sam(sam)}
                if rid not in current:
                    raise RuntimeError('Выбранный RID отсутствует в текущем SAM; изменений нет.')
                if action == 'demote':
                    if rid == '01f4':
                        raise RuntimeError('Права встроенной учётной записи Administrator (RID 01f4) не изменяются.')
                    usable_admins = sum(a['admin'] is True and a['rid'] != '01f4'
                                        and bool(a['flags']) and not (int(a['flags'], 16) & 0x0001)
                                        for a in current.values())
                    if usable_admins <= 1:
                        raise RuntimeError('Нельзя снять права у последнего обнаруженного обычного администратора.')
                backup = make_backup(config)
                command = {'promote': ['/usr/sbin/samusrgrp', '-a', '-u', f'0x{rid}', '-g', '0x220', str(sam)],
                           'demote': ['/usr/sbin/samusrgrp', '-r', '-u', f'0x{rid}', '-g', '0x220', str(sam)],
                           'unlock': ['/usr/sbin/samunlock', '-U', '-u', f'0x{rid}', str(sam)],
                           'clear': ['/usr/sbin/sampasswd', '-r', '-u', f'0x{rid}', str(sam)]}[action]
                run(command)
                run(['/usr/bin/sync'])
                after = {a['rid']: a for a in accounts_from_sam(sam)}
                if action == 'promote' and after.get(rid, {}).get('admin') is False:
                    raise RuntimeError(f'Команда завершилась, но права не подтверждены. Резервная копия: {backup}')
                if action == 'demote' and after.get(rid, {}).get('admin') is True:
                    raise RuntimeError(f'Команда завершилась, но снятие прав не подтверждено. Резервная копия: {backup}')
                logging.info('completed action=%s rid=%s backup=%s', action, rid, backup)
                return str(backup)
        def done(backup):
            messagebox.showinfo('Готово', f'Действие выполнено. Резервная копия: {backup}\nПерезагрузите Windows для проверки.')
            self.load_users()
        self.task('Изменение учётной записи', work, done)

    def prepare_windows_helper(self):
        if not self.device:
            messagebox.showinfo('Сначала раздел', 'Выберите раздел Windows в верхнем списке.')
            return
        if not messagebox.askyesno('Подтверждение',
                                   f'Скопировать графический помощник и фото на раздел {self.device} в общую папку рабочего стола Windows?'):
            return
        device = self.device
        def work():
            source = Path('/usr/local/share/windows-rescue')
            files = ('Start-Windows-Rescue.cmd', 'WindowsRescue.ps1', 'wallpaper.png')
            if not all((source / name).is_file() for name in files):
                raise RuntimeError('Файлы помощника отсутствуют в загрузочном образе.')
            with MountedWindows(device, read_write=True) as config:
                root = config.parent.parent.parent
                public = root / 'Users/Public'
                if not public.is_dir():
                    raise RuntimeError('Папка Users/Public не найдена на выбранном разделе Windows.')
                target = public / 'Desktop/Windows Rescue'
                target.mkdir(parents=True, exist_ok=True)
                for name in files:
                    shutil.copy2(source / name, target / name)
                run(['/usr/bin/sync'])
                logging.info('Windows helper prepared: %s', target)
                return str(target)
        def done(target):
            messagebox.showinfo('Помощник подготовлен',
                                f'Файлы скопированы в {target}. Перезагрузитесь в Windows, войдите с правами администратора и откройте «Windows Rescue» на рабочем столе → Start-Windows-Rescue.cmd. Там будут кнопки смены пароля, создания пользователя и закрепления обоев.')
        self.task('Подготовка помощника Windows', work, done)

    def show_log(self):
        self.log_text.configure(state='normal')
        self.log_text.delete('1.0', 'end')
        self.log_text.insert('end', LOG_FILE.read_text(encoding='utf-8', errors='replace'))
        self.log_text.see('end')
        self.log_text.configure(state='disabled')

    def export_log(self):
        filename = filedialog.asksaveasfilename(title='Сохранить диагностический отчёт',
                                                defaultextension='.txt',
                                                initialfile='rescue-debug.txt',
                                                filetypes=[('Текст', '*.txt')])
        if filename:
            shutil.copyfile(LOG_FILE, filename)
            os.chmod(filename, 0o600)
            messagebox.showinfo('Отчёт сохранён', filename)


if __name__ == '__main__':
    if os.geteuid() != 0:
        raise SystemExit('rescue-gui must run as root')
    window = tk.Tk()
    style = ttk.Style(window)
    if 'clam' in style.theme_names():
        style.theme_use('clam')
    RescueGUI(window)
    window.mainloop()
